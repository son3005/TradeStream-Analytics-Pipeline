# =====================================================================
# TRADE STREAM ANALYTICS PIPELINE - MẪU FILE CẤU HÌNH MÔI TRƯỜNG (.env)
# =====================================================================
# HƯỚNG DẪN:
# 1. Copy file này thành file `.env` tại thư mục gốc của dự án:
#    cp .env.example .env
# 2. Thay đổi toàn bộ các giá trị 'CHANGE_ME' thành mật khẩu thực tế của bạn
#    trước khi khởi chạy Docker Compose.
# =====================================================================

# ---------------------------------------------------------------------
# 1. KAFKA CONFIGURATION
# ---------------------------------------------------------------------
# Địa chỉ Broker của Kafka (sử dụng trên máy host)
KAFKA_BROKER_URL=localhost:9092

# ---------------------------------------------------------------------
# 2. DATA SOURCE PATHS (APIs / STREAMS)
# ---------------------------------------------------------------------
# Đường dẫn luồng Binance WebSocket (Crypto Ticks)
BINANCE_WSS_URL=wss://stream.binance.com:9443/ws/btcusdt@trade

# Đường dẫn API Yahoo Finance Chart (Cổ phiếu)
YAHOO_FINANCE_URL=https://query1.finance.yahoo.com/v8/finance/chart

# ---------------------------------------------------------------------
# 3. TIMESCALEDB (Serving Database & Crypto Data Storage)
# ---------------------------------------------------------------------
# Mật khẩu tài khoản admin 'postgres' của TimescaleDB
TIMESCALE_PASSWORD=CHANGE_ME
# Chuỗi kết nối Postgres của Airflow / Spark trỏ tới TimescaleDB
TIMESCALE_CONN=host=timescaledb port=5432 dbname=tradestream user=postgres password=CHANGE_ME

# ---------------------------------------------------------------------
# 4. GRAFANA (Dashboard & Trực quan hóa)
# ---------------------------------------------------------------------
# Tài khoản & mật khẩu đăng nhập trang Grafana (localhost:3000)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------
# 5. AIRFLOW METADATA DATABASE (Database nội bộ quản lý lịch trình)
# ---------------------------------------------------------------------
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=CHANGE_ME
AIRFLOW_DB_NAME=airflow
# Chuỗi kết nối SQLAlchemy để Airflow ghi nhận thông số chạy job
AIRFLOW_DB_CONN=postgresql+psycopg2://airflow:CHANGE_ME@airflow-metadata:5432/airflow

# ---------------------------------------------------------------------
# 6. AIRFLOW AUTHENTICATION & SECURITY (Bảo mật giao diện Web)
# ---------------------------------------------------------------------
AIRFLOW_JWT_SECRET=CHANGE_ME_USE_RANDOM_STRING
AIRFLOW_SECRET_KEY=CHANGE_ME_USE_RANDOM_STRING

# Cấu hình tài khoản đăng nhập Airflow UI (localhost:8085)
# Định dạng: username:password:role (Ví dụ ở đây là admin / CHANGE_ME / quyền Admin)
AIRFLOW_ADMIN_USERS=admin:CHANGE_ME:Admin

# ---------------------------------------------------------------------
# 7. MINIO (Lakehouse Object Storage)
# ---------------------------------------------------------------------
# Tài khoản và mật khẩu của trang quản lý MinIO Console (localhost:9001)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGE_ME
# Tên bucket lưu trữ hồ dữ liệu Medallion Lakehouse
MINIO_LAKEHOUSE_BUCKET=lakehouse

# ---------------------------------------------------------------------
# 8. TELEGRAM NOTIFICATION ALERTING (Cảnh báo lỗi qua Telegram - Tùy chọn)
# ---------------------------------------------------------------------
# Điền Token của Bot Telegram của bạn (Ví dụ: 123456789:ABCdefGh...)
TELEGRAM_BOT_TOKEN=
# Điền Chat ID nhận thông báo lỗi (Ví dụ: -100123456789 hoặc ID cá nhân)
TELEGRAM_CHAT_ID=
