      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TimescaleDB"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH actual_directions AS (SELECT fetch_date, symbol, CASE WHEN close_price > LAG(close_price, 1) OVER (PARTITION BY symbol ORDER BY fetch_date) THEN 1 ELSE 0 END AS actual_direction FROM daily_prices) SELECT p.prediction_date::timestamp AS time, p.symbol || ' (Predicted)' AS metric, p.predicted_direction AS value FROM daily_predictions p INNER JOIN actual_directions a ON p.symbol = a.symbol AND p.prediction_date = a.fetch_date WHERE $__timeFilter(p.prediction_date) UNION ALL SELECT a.fetch_date::timestamp AS time, a.symbol || ' (Actual)' AS metric, a.actual_direction AS value FROM actual_directions a INNER JOIN daily_predictions p ON p.symbol = a.symbol AND p.prediction_date = a.fetch_date WHERE $__timeFilter(a.fetch_date) ORDER BY time, metric",
          "refId": "A"
        }
      ],
      "title": "ML Price Direction: Forecast vs. Actual",
      "type": "timeseries"
