      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TimescaleDB"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT symbol AS \"Symbol\", window_start AS \"Last Window Start\", sma AS \"Current SMA (USD)\", vwap AS \"Current VWAP (USD)\", trade_count AS \"Trades in Window\" FROM (SELECT *, ROW_NUMBER() OVER (PARTITION BY symbol ORDER BY window_start DESC) as rn FROM crypto_indicators) t WHERE rn = 1 ORDER BY symbol ASC",
          "refId": "A"
        }
      ],
      "title": "Latest Real-Time Indicators Summary",
      "type": "table"
